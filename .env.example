# Copy to .env (make setup does this). Never commit .env.
# Coding agents can read this file: never put tokens or keys in it (AGENTS.md invariant 13).
# Comments stay on their own lines: the Makefile includes this file, and make keeps trailing spaces.

# --- LLM: local open-weight model via Ollama (ADR-0013) ---
# Provider: ollama | none | openai_compat (hosted fallback, off by default; marks SCI incomplete)
EG_LLM_PROVIDER=ollama
EG_OLLAMA_URL=http://localhost:11434
# One resident model, two reasoning levels. Verify tags with `ollama list`.
EG_MODEL_SMALL=gpt-oss:20b
EG_MODEL_LARGE=gpt-oss:20b
EG_THINK_SMALL=low
EG_THINK_LARGE=medium
EG_NUM_CTX=16384
# Models compared by `make bakeoff` (think level: gpt-oss uses the values above; Qwen runs with think off)
EG_BAKEOFF_MODELS=gpt-oss:20b,qwen3.5:9b,qwen3.6:27b-coding

# Hosted fallback: an OpenAI-compatible endpoint serving an open-weight model. Using it marks SCI incomplete.
# Put the key in your shell environment, not here.
EG_OPENAI_COMPAT_URL=

# --- Estate and delivery ---
# Generated Terraform for offline/local modes
EG_ESTATE_DIR=./.estate
# Live mode only: owner/emissiongate-demo-estate
EG_ESTATE_REPO=
# GITHUB_TOKEN is NOT read from this file. Export it in your own terminal only when running make demo-live:
#   export GITHUB_TOKEN=...   (fine-grained: Contents + Pull requests read/write on the estate repo only)

# --- Tooling ---
EG_TOFU_BIN=tofu
# Local provider mirror created by `make providers` (ADR-0014)
EG_TOFU_PLUGIN_DIR=.tofu-providers

# --- Grid intensity ---
# uk = UK Carbon Intensity API for eu-west-2; off = snapshot + annual tiers only
EG_GRID_LIVE=uk

# --- Agent footprint (SCI) ---
# Manufacturer product carbon footprint of this laptop in kgCO2e. Blank = reported as "not declared".
EG_DEVICE_EMBODIED_KG_CO2E=
EG_DEVICE_LIFESPAN_YEARS=4
